# aicore  = LLM through SAP AI Core (needs the credentials below)
# offline = no LLM; PO numbers are found by regex (protocol demo/tests only)
LLM_MODE=aicore

# SAP AI Core service key values (read directly by the SAP AI SDK)
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
# must end in /oauth/token
AICORE_AUTH_URL=
# must end in /v2
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default

# An OpenAI model with a RUNNING deployment in your AI Core resource group
AICORE_MODEL=

SAP_AGENT_HOST=127.0.0.1
SAP_AGENT_PORT=9001
# URL advertised in the agent card
SAP_AGENT_URL=http://127.0.0.1:9001

# Optional HTTP Basic auth on the A2A endpoint; leave unset for no authentication
# SAP_AGENT_USERNAME=
# SAP_AGENT_PASSWORD=

# Where PO data comes from:
# json  = data/sap_purchase_orders.json (offline demo/tests)
# odata = SAP S/4HANA API_PURCHASEORDER_PROCESS_SRV
SAP_MODE=odata
SAP_ODATA_BASE_URL=http://192.168.8.69:50000/sap/opu/odata/sap/API_PURCHASEORDER_PROCESS_SRV
SAP_CLIENT=100
# SAP technical user with read access to purchase orders
SAP_USERNAME=
SAP_PASSWORD=
# set to false only for a self-signed certificate on an internal https URL
SAP_VERIFY_TLS=true
