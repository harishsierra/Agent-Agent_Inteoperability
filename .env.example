# aicore  = LLM through SAP AI Core (needs the credentials below)
# offline = no LLM; PO numbers are found by regex (protocol demo/tests only)
LLM_MODE=aicore

# SAP AI Core service key values (read directly by the SAP AI SDK)
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
# must end in /oauth/token
AICORE_AUTH_URL=
# must end in /v2
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default

# An OpenAI model with a RUNNING deployment in your AI Core resource group
AICORE_MODEL=

SAP_AGENT_HOST=127.0.0.1
SAP_AGENT_PORT=9001
# URL advertised in the agent card
SAP_AGENT_URL=http://127.0.0.1:9001

# HTTP Basic auth required on the A2A endpoint (the agent card stays public)
SAP_AGENT_USERNAME=Admin
SAP_AGENT_PASSWORD=Admin@123
